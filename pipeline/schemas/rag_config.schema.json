{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rag_config.json (AGENTS.md §8: thresholds calibrated on eval/golden.jsonl, shipped in the core pack)",
  "type": "object",
  "required": ["top_k", "pool_size", "rrf_k", "min_matched_terms", "min_coverage"],
  "additionalProperties": false,
  "properties": {
    "top_k": {"type": "integer", "minimum": 1, "maximum": 10},
    "pool_size": {"type": "integer", "minimum": 1},
    "rrf_k": {"type": "integer", "minimum": 1},
    "min_matched_terms": {"type": "integer", "minimum": 1},
    "min_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "min_similarity": {"type": "number"}
  }
}
