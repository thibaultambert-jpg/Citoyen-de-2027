{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "theme_overrides.yaml",
  "type": "object",
  "required": ["version", "overrides"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "id", "themes"],
        "additionalProperties": false,
        "properties": {
          "target": {"enum": ["ballot", "chunk"]},
          "id": {"type": "string", "minLength": 1},
          "themes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
