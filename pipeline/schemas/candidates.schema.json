{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidates.yaml — hand-maintained list (AGENTS.md §6, §10)",
  "type": "object",
  "required": ["version", "inclusion_policy_date", "candidates"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "inclusion_policy_date": {"type": "string", "format": "date"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name", "sort_name", "status", "status_date", "status_source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "display_name": {"type": "string", "minLength": 1},
          "sort_name": {"type": "string", "minLength": 1},
          "status": {"enum": ["DECLARE", "RETIRE", "OFFICIEL"]},
          "status_date": {"type": "string", "format": "date"},
          "status_source": {"$ref": "#/$defs/source"}
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["name", "url", "retrieved_on", "license"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "retrieved_on": {"type": "string", "format": "date"},
        "license": {"type": "string", "minLength": 1}
      }
    }
  }
}
