{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "themes.yaml",
  "type": "object",
  "required": ["version", "unknown_label", "themes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "unknown_label": {"type": "string", "minLength": 1},
    "themes": {
      "type": "array",
      "minItems": 15,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "label", "patterns"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "not": {"const": "inconnu"}},
          "label": {"type": "string", "minLength": 1},
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
        }
      }
    }
  }
}
